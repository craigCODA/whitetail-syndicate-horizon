

<a
  href="{{ routes.root_url }}#top"
  class="header-logo ws-header-brand"
  aria-label="Whitetail Syndicate home"
  {{ block.shopify_attributes }}
>
  <img
    class="ws-header-brand__logo"
    src="{{ 'ws-story-brand.png' | asset_url }}"
    alt=""
    width="58"
    height="62"
    loading="eager"
  >
  <span class="ws-header-brand__wordmark" aria-hidden="true">
    <span>WHITETAIL</span>
    <span>SYNDICATE</span>
  </span>
</a>
<nav class="ws-draft-top-navigation" aria-label="Main navigation">
  <ul class="ws-draft-top-navigation__list">
    {% render 'ws-header-nav-desktop' %}
  </ul>
</nav>
<details class="ws-draft-mobile-navigation">
  <summary aria-label="Open Whitetail Syndicate navigation">Menu <span aria-hidden="true">▾</span></summary>
  <nav aria-label="Mobile navigation">
    <ul>{% render 'ws-header-nav-mobile' %}</ul>
  </nav>
</details>
{{ 'ws-header-navigation.css' | asset_url | stylesheet_tag }}

{% style %}
  @font-face {
    font-family: "WS Header Oswald";
    src: url("{{ 'ws-oswald-500.woff2' | asset_url }}") format("woff2");
    font-style: normal;
    font-weight: 500;
    font-display: swap;
  }
  @font-face {
    font-family: "WS Header Barlow";
    src: url("{{ 'ws-barlow-600.woff2' | asset_url }}") format("woff2");
    font-style: normal;
    font-weight: 600;
    font-display: swap;
  }
{% endstyle %}

{% stylesheet %}
  .ws-header-brand.header-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex: 0 0 auto;
    width: auto;
    height: 100%;
    min-width: 0;
    max-width: none;
    padding: 0;
    text-decoration: none;
    white-space: nowrap;
    color: #f6f1e7;
  }
  .ws-header-brand.header-logo:hover,
  .ws-header-brand.header-logo:focus-visible {
    text-decoration: none;
    color: #f6f1e7;
  }
  .ws-header-brand__logo {
    display: block;
    width: 58px;
    height: 62px;
    max-width: none;
    object-fit: contain;
    flex: 0 0 58px;
  }
  .ws-header-brand__wordmark {
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-family: "WS Header Oswald", "Oswald", "Arial Narrow", Arial, sans-serif;
    font-weight: 500;
    font-size: 18px;
    line-height: 0.96;
    letter-spacing: 0.12em;
  }
  .ws-header-brand__wordmark span:last-child {
    font-size: 13px;
    letter-spacing: 0.18em;
    color: #e0c089;
  }
  #header-component .header-menu .menu-list__link {
    font-family: "WS Header Barlow", "Barlow", Arial, sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  #header-component .header-menu .menu-list__link-title {
    padding-inline: clamp(7px, 0.75vw, 12px);
  }
  #header-component .header-menu .menu-list__link[href$="#top"],
  #header-component .header-menu .menu-list__link[href="/"] {
    color: #e0c089;
  }
  #header-component .header-menu .menu-list__link:hover,
  #header-component .header-menu .menu-list__link:focus-visible {
    color: #e0c089;
  }
  #header-component:has(.ws-draft-top-navigation) .header-menu,
  #header-component:has(.ws-draft-top-navigation) .header__drawer {
    display: none !important;
  }
  #header-component .ws-draft-top-navigation {
    display: flex;
    align-items: center;
    min-width: 0;
    flex: 1 1 auto;
    margin-left: clamp(25px, 7vw, 130px);
    font: 600 12px/1.3 "WS Header Barlow", "Barlow", Arial, sans-serif;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  #header-component .ws-draft-top-navigation__list {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    gap: clamp(7px,1.1vw,18px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #header-component .ws-draft-top-navigation .menu-list__list-item {
    display: flex;
    align-items: center;
    position: relative;
    min-width: 0;
    flex: 0 0 auto;
  }
  #header-component .ws-draft-top-navigation .menu-list__link {
    display: flex;
    align-items: center;
    height: 46px;
    padding: 0;
    margin: 0;
    text-decoration: none;
    white-space: nowrap;
    color: #f6f1e7;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    text-transform: uppercase;
  }
  #header-component .ws-draft-top-navigation .menu-list__link-title {padding:0;}
  #header-component .ws-draft-top-navigation .ws-home-nav-link,
  #header-component .ws-draft-top-navigation .menu-list__link:hover,
  #header-component .ws-draft-top-navigation .menu-list__link:focus-visible {
    color: #e0c089;
  }
  #header-component .ws-draft-top-navigation .ws-lifestyle-dropdown__trigger {
    cursor: pointer;
    list-style: none;
  }
  #header-component .ws-draft-top-navigation .ws-lifestyle-dropdown__trigger::-webkit-details-marker {display:none;}
  #header-component .ws-draft-top-navigation .ws-lifestyle-dropdown__panel {
    position: absolute;
    top: 100%;
    left: -8px;
    z-index: 60;
    display: none;
    flex-direction: column;
    min-width: 205px;
    background: #17130f;
    border: 1px solid rgba(224,192,137,.4);
    box-shadow: 0 12px 32px rgba(0,0,0,.5);
    padding: 8px;
  }
  #header-component .ws-draft-top-navigation .ws-lifestyle-dropdown[open] .ws-lifestyle-dropdown__panel,
  #header-component .ws-draft-top-navigation .ws-lifestyle-dropdown:focus-within .ws-lifestyle-dropdown__panel,
  #header-component .ws-draft-top-navigation .ws-lifestyle-dropdown:hover .ws-lifestyle-dropdown__panel {display:flex;}
  #header-component .ws-draft-top-navigation .ws-lifestyle-dropdown__panel a {
    color:#f6f1e7;
    font:600 12px/1.3 "WS Header Barlow",Arial,sans-serif;
    letter-spacing:.08em;
    text-decoration:none;
    padding:11px 12px;
  }
  #header-component .ws-draft-top-navigation .ws-lifestyle-dropdown__panel a:hover,
  #header-component .ws-draft-top-navigation .ws-lifestyle-dropdown__panel a:focus-visible {
    color:#e0c089;background:rgba(224,192,137,.12);
  }
  #header-component .ws-draft-mobile-navigation {display:none;position:relative;z-index:80;}
  @media screen and (max-width:1350px) {
    #header-component .ws-draft-top-navigation {display:none;}
    #header-component .ws-draft-mobile-navigation {
      display:block;
      margin-inline-start: 14px;
      font:600 12px/1.4 "WS Header Barlow",Arial,sans-serif;
      text-transform:uppercase;
      letter-spacing:.1em;
    }
    #header-component .ws-draft-mobile-navigation > summary {
      list-style:none;cursor:pointer;
      border:1px solid rgba(224,192,137,.45);
      padding:10px 12px;
      color:#e0c089;
    }
    #header-component .ws-draft-mobile-navigation > summary::-webkit-details-marker{display:none;}
    #header-component .ws-draft-mobile-navigation nav {
      position:absolute;
      right:0;top:calc(100% + 8px);
      width:min(330px,calc(100vw - 28px));
      max-height:min(70vh,570px);
      overflow-y:auto;
      background:#17130f;
      border:1px solid rgba(224,192,137,.45);
      box-shadow:0 16px 40px rgba(0,0,0,.65);
      z-index:90;
    }
    #header-component .ws-draft-mobile-navigation nav ul {
      list-style:none;margin:0;padding:8px;
    }
    #header-component .ws-draft-mobile-navigation nav .menu-drawer__menu-item {
      display:flex;
      text-decoration:none;
      color:#f6f1e7;
      padding:13px 12px;
      font-size:13px;
      border-bottom:1px solid rgba(224,192,137,.12);
    }
    #header-component .ws-draft-mobile-navigation nav .ws-mobile-lifestyle__links a{
      display:block;color:#e0c089;text-decoration:none;padding:11px 20px;
    }
    #header-component .ws-draft-mobile-navigation nav .ws-mobile-lifestyle summary {
      display:block;color:#f6f1e7;padding:13px 12px;cursor:pointer;
    }
  }
  @media screen and (min-width: 871px) and (max-width: 1100px) {
    .ws-header-brand__wordmark { display: none; }
  }
  @media screen and (max-width: 870px) {
    .ws-header-brand__logo {
      width: 52px;
      height: 56px;
      flex-basis: 52px;
    }
    .ws-header-brand__wordmark { font-size: 16px; }
    .ws-header-brand__wordmark span:last-child { font-size: 11px; }
  }
  @media screen and (max-width: 570px) {
    .ws-header-brand__logo {
      width: 48px;
      height: 52px;
      flex-basis: 48px;
    }
    .ws-header-brand__wordmark { font-size: 14px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.logo",
  "tag": null,
  "class": "header-logo",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.edit_logo_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_logo_on_home_page",
      "label": "t:settings.hide_logo_on_home_page",
      "info": "t:info.hide_logo_on_home_page_help"
    },
    {
      "type": "header",
      "content": "t:content.padding_desktop"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
