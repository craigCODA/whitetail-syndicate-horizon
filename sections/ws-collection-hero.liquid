{% comment %}
  Whitetail Syndicate collection masthead.
  Uses the approved cleaned collection images; preserves the homepage artwork separately.
  Shared by /collections/all, category collections and paginated collection URLs.
{% endcomment %}
{{ 'ws-collection-hero.css' | asset_url | stylesheet_tag }}

{% liquid
  assign is_full_catalog = false
  if collection.handle == 'all'
    assign is_full_catalog = true
  endif

  assign artwork_url = blank
  assign artwork_width = 1374
  assign artwork_height = 1145
  case collection.handle
    when 'all'
      assign artwork_url = 'https://cdn.shopify.com/s/files/1/0689/1087/4727/files/ws-catalog-six-panel-header.png?v=1791518554'
      assign artwork_width = 2172
      assign artwork_height = 724
    when 'the-buck-collection'
      assign artwork_url = 'https://cdn.shopify.com/s/files/1/0689/1087/4727/files/ws-collection-clean-buck.png?v=1791518489'
    when 'the-doe-collection'
      assign artwork_url = 'https://cdn.shopify.com/s/files/1/0689/1087/4727/files/ws-collection-clean-doe.png?v=1791518497'
      assign artwork_width = 1375
      assign artwork_height = 1144
    when 'the-yearling-collection'
      assign artwork_url = 'https://cdn.shopify.com/s/files/1/0689/1087/4727/files/ws-collection-clean-yearling.png?v=1791518512'
    when 'the-fawn-collection'
      assign artwork_url = 'https://cdn.shopify.com/s/files/1/0689/1087/4727/files/ws-collection-clean-fawn.png?v=1791518530'
      assign artwork_width = 1375
      assign artwork_height = 1144
    when 'hats-beanies'
      assign artwork_url = 'https://cdn.shopify.com/s/files/1/0689/1087/4727/files/ws-collection-clean-hats-beanies.png?v=1791518536'
      assign artwork_width = 1374
      assign artwork_height = 1145
    when 'gear-accessories'
      assign artwork_url = 'https://cdn.shopify.com/s/files/1/0689/1087/4727/files/ws-collection-clean-gear-accessories.png?v=1791518544'
      assign artwork_width = 1374
      assign artwork_height = 1145
    when 'rutline'
      assign artwork_url = 'ws-rutline-full.png' | asset_url
      assign artwork_width = 1254
      assign artwork_height = 1254
  endcase
%}

<section class="ws-collection-hero{% if is_full_catalog %} ws-collection-hero--all{% endif %}" aria-labelledby="ws-collection-title" {{ section.shopify_attributes }}>
  {% if artwork_url != blank and section.settings.show_artwork %}
    <div
      class="ws-collection-hero__artwork"
      style="--ws-collection-artwork: url('{{ artwork_url }}');"
    >
      <img
        class="ws-collection-hero__image"
        src="{{ artwork_url }}"
        alt="{{ collection.title | escape }}"
        width="{{ artwork_width }}"
        height="{{ artwork_height }}"
        loading="eager"
        decoding="async"
      >
    </div>
  {% endif %}

  <div class="ws-collection-hero__details">
    <p class="ws-collection-hero__eyebrow">
      {% if is_full_catalog %}
        Whitetail Syndicate / The Store
      {% else %}
        Whitetail Syndicate / The Collections
      {% endif %}
    </p>
    <h1 class="ws-collection-hero__title" id="ws-collection-title">
      {% if is_full_catalog %}
        Shop All Gear
      {% else %}
        {{ collection.title | escape }}
      {% endif %}
    </h1>
    {% if section.settings.show_description %}
      {% if collection.description != blank %}
        <div class="ws-collection-hero__description rte">{{ collection.description }}</div>
      {% elsif is_full_catalog %}
        <p class="ws-collection-hero__description">Explore all Whitetail Syndicate apparel, hats, and gear.</p>
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "WS collection intro",
  "tag": "section",
  "class": "ws-collection-hero-section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "checkbox", "id": "show_artwork", "label": "Show collection artwork", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true }
  ],
  "presets": [{ "name": "WS collection intro" }]
}
{% endschema %}
