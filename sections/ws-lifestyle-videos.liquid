{% render 'ws-home-styles' %}
{{ 'ws-lifestyle.css' | asset_url | stylesheet_tag }}
{% assign ws_lifestyle_image = 'https://cdn.shopify.com/s/files/1/0689/1087/4727/files/lifestyle_and_video.png?v=1788601387' %}
